# Copy to supabase/functions/.env for local Edge Function development only.
# Never place these values in the Vite root .env or commit the real file.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-me
# Optional. Omit when the bucket policy/Object Ownership setup does not use ACLs.
# AWS_S3_PUBLIC_ACL=public-read

# LocalStack only. This hostname must be reachable unchanged from BOTH the
# Supabase Edge Runtime container and the browser because it is signed.
# AWS_S3_ENDPOINT=http://host.docker.internal:4566
# AWS_S3_FORCE_PATH_STYLE=true
